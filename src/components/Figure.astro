---
/** Иллюстрация в теле статьи (в MDX: `<Figure src={img} alt="…" />`). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /**
   * natural — картинка целиком в своих пропорциях (по умолчанию: слайды 16:9 нельзя обрезать);
   * cover / contain — рамка 883×430 как в макете, с обрезкой / со вписыванием.
   */
  fit?: 'natural' | 'cover' | 'contain';
  caption?: string;
}
const { src, alt, fit = 'natural', caption } = Astro.props;
---

<figure class:list={['figure', `figure--${fit}`]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 1100px) 100vw, 980px"
    loading="lazy"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    width: 100%;
  }
  .figure :global(img) {
    width: 100%;
    height: auto;
  }
  .figure--cover :global(img),
  .figure--contain :global(img) {
    aspect-ratio: 883 / 430;
    object-fit: cover;
    background: #f5f2fd;
  }
  .figure--contain :global(img) {
    object-fit: contain;
    background: transparent;
  }
  figcaption {
    margin-top: 12px;
    color: var(--c-text-2);
    font-size: var(--fs-small);
  }
</style>
