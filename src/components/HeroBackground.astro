---
/**
 * Анимированная «клякса» в hero — видео-заливка из Figma (2604146_Backgrounds_Abstract_1280x720,
 * blend = color-burn). Файл `hero-blob-loop.mp4` — тот же ролик, пересобранный в бесшовную петлю:
 * исходник (10 с) не зациклен — начинается бугристой формой, заканчивается гладкой, поэтому хвост
 * (8–10 с) плавно растворён в начало (0–2 с), длительность петли 8 с, 30 к/с. Последний кадр
 * переходит в первый без скачка, так что обычный `loop` не заметен. Как пересобрать: docs/HERO_BLOB.md.
 *
 * Серый фон ролика (#e3e3e3) остаётся в кадре — как в Figma, видео целиком смешивается с градиентом hero
 * через `mix-blend-mode: color-burn`. Слой `::before` продолжает этот серый за краями видео (на узких экранах
 * ролик не закрывает hero целиком), поэтому границы кадра не видны.
 *
 * Геометрия из макета (hero 1728×1117): слой 2600×1462 (масштаб 2,0317 к видео), центр кадра в
 * (79,17% − 84 px ; 50% + 19 px), поворот 0,23°. Единица `--k` = px на 1 px видео; на ширине 1728 это 2,0317.
 *
 * Без JS и при prefers-reduced-motion видео не запускается — виден постер (первый кадр петли).
 * Вне экрана и в неактивной вкладке видео ставится на паузу.
 */
import loop from '../assets/bg/hero-blob-loop.mp4';
import poster from '../assets/bg/hero-blob-poster.webp';
---

<div class="hero-bg" aria-hidden="true">
  <video
    class="hero-bg__video"
    src={loop}
    poster={poster.src}
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    tabindex="-1"
    data-hero-video></video>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video) {
    let visible = true;
    const sync = () => {
      const shouldPlay = visible && !reduceMotion.matches && document.visibilityState === 'visible';
      if (shouldPlay) video.play().catch(() => {});
      else video.pause();
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      }).observe(video);
    }
    document.addEventListener('visibilitychange', sync);
    reduceMotion.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .hero-bg {
    --k: max(0.11757vw, 0.9px); /* px CSS на 1 px видео (2,0317 при ширине 1728) */
    --ax: 74.32%; /* центр видео-кадра в hero: 79,17% − 84 px ≈ 74,3% ширины */
    --ay: 33.43vw; /* 50% + 19 px от высоты 1117 ≈ 33,4vw */

    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* без z-index: иначе wrapper станет stacking context и blend не увидит градиент hero */
  }

  /* Серый фон ролика (#e3e3e3) с тем же color-burn, что у видео в Figma. */
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #e3e3e3;
    mix-blend-mode: color-burn;
  }

  .hero-bg__video {
    position: absolute;
    left: calc(var(--ax) - 640 * var(--k));
    top: calc(var(--ay) - 360 * var(--k));
    width: calc(1280 * var(--k));
    height: calc(720 * var(--k));
    max-width: none;
    object-fit: fill;
    mix-blend-mode: color-burn;
    transform: rotate(0.23deg);
  }

  /* Мобильный: ролик не масштабируется ниже 0,9 px на px видео и сдвигается, чтобы оставаться в кадре */
  @media (max-width: 767px) {
    .hero-bg {
      --ax: 66%;
      --ay: 300px;
    }
  }
</style>
