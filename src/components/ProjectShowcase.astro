---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  category: string;
  tag: string;
  description: string;
  preview: ImageMetadata;
  thumbs?: ImageMetadata[];
  /** Ссылка на страницу проекта или внешний сайт. Без неё карточка не кликабельна. */
  href?: string;
  /** Внешняя ссылка: открывается в новой вкладке. */
  external?: boolean;
  /** Надпись, выезжающая у кнопки при наведении («Перейти на сайт»); она же входит в aria-label ссылки. */
  ctaText?: string;
  /** object-position превью, если важную часть кадра обрезает рамка 1012×534. */
  previewPosition?: string;
  /** Зеркальная раскладка: карточка слева, превью справа. */
  mirrored?: boolean;
  /** arrow — круглая кнопка с выезжающей надписью; none — без кнопки. */
  cta?: 'arrow' | 'none';
  eager?: boolean;
}
const {
  title,
  category,
  tag,
  description,
  preview,
  thumbs = [],
  href,
  external = false,
  ctaText = 'Перейти к кейсу',
  previewPosition,
  mirrored = false,
  cta = 'arrow',
  eager = false,
} = Astro.props;

const fulls = await Promise.all(
  thumbs.map((t) => getImage({ src: t, width: 1400, format: 'webp' })),
);
const CtaTag = href ? 'a' : 'span';
const linkProps = href && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const ctaLabel = href ? `${ctaText}: ${title}${external ? ' (откроется в новой вкладке)' : ''}` : undefined;
const previewProps = {
  src: preview,
  alt: '',
  widths: [640, 1012, 1400],
  sizes: '(max-width: 1100px) 100vw, 66vw',
  loading: eager ? ('eager' as const) : ('lazy' as const),
  class: 'showcase__img',
  'data-main': true,
};
---

<article class:list={['showcase', { 'showcase--mirrored': mirrored }]} data-reveal>
  <div
    class="showcase__media"
    data-gallery
    style={previewPosition ? `--pos:${previewPosition}` : undefined}
  >
    <Image {...previewProps} />
    {
      thumbs.length > 0 && (
        <ul class="thumbs" aria-label={`Скриншоты проекта ${title}`}>
          {thumbs.map((t, i) => (
            <li>
              <button
                type="button"
                class="thumb"
                data-full={fulls[i].src}
                aria-label={`Показать скриншот ${i + 1}`}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <Image src={t} alt="" width={156} height={112} loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="showcase__card">
    {
      cta !== 'none' && (
        <CtaTag
          class:list={['cta', `cta--${cta}`, { 'cta--static': !href }]}
          href={href}
          {...linkProps}
          aria-label={ctaLabel}
          aria-hidden={href ? undefined : 'true'}
        >
          <span class="cta__circle">
            <Icon name="arrow-right" />
          </span>
          {href && <span class="cta__label">{ctaText}</span>}
        </CtaTag>
      )
    }
    <div class="info">
      <div class="meta">
        <span class="meta__cat">{category}</span>
        <span class="meta__dot" aria-hidden="true"></span>
        <span class="meta__tag">{tag}</span>
      </div>
      <h3 class="info__title">
        {href ? (
          <a href={href} {...linkProps}>
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
      <p class="info__desc">{description}</p>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-main]');
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.thumb'));
    if (!main) return;
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const full = btn.dataset.full;
        if (!full) return;
        main.removeAttribute('srcset');
        main.removeAttribute('sizes');
        main.src = full;
        buttons.forEach((b) => b.removeAttribute('aria-current'));
        btn.setAttribute('aria-current', 'true');
      }),
    );
  });
</script>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1012fr) minmax(0, 496fr);
    align-items: stretch;
    gap: 20px;
  }
  .showcase--mirrored {
    grid-template-columns: minmax(0, 496fr) minmax(0, 1012fr);
  }
  .showcase--mirrored .showcase__media {
    order: 2;
  }
  .showcase--mirrored .showcase__card {
    order: 1;
  }

  /* Превью */
  .showcase__media {
    position: relative;
    min-width: 0;
    border-radius: var(--r-preview);
    overflow: hidden;
    background: #eee9fb;
    container-type: inline-size;
  }
  /* Пропорции 1012:534 — минимальная высота; если текст карточки выше, превью растягивается по строке сетки
     (aspect-ratio тут не годится: при растяжении он расширял бы превью за пределы колонки) */
  .showcase__media::before {
    content: '';
    display: block;
    padding-top: calc(534 / 1012 * 100%);
  }
  .showcase__media :global(.showcase__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }
  .thumbs {
    position: absolute;
    right: 2.7%;
    bottom: 4.3%;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thumb {
    display: block;
    /* единый размер у всех карточек (не зависит от числа миниатюр); растёт вместе с превью */
    width: clamp(32px, 7cqw, 72px);
    aspect-ratio: 78 / 56;
    border: 1px solid var(--c-border-thumb);
    border-radius: var(--r-thumb);
    overflow: hidden;
    background: #fff;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb[aria-current='true'] {
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }
  @media (min-width: 1101px) and (hover: hover) {
    .thumb:hover {
      border-color: var(--c-accent);
      transform: translateY(-2px);
    }
  }

  /* Карточка */
  .showcase__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-inline-start: 24px;
    min-height: 100%;
    border-radius: var(--r-card);
  }
  .showcase--mirrored .showcase__card {
    align-items: flex-start;
    padding-inline-start: 0;
    padding-inline-end: 24px;
  }
  .cta {
    display: inline-flex;
    flex-direction: row-reverse; /* карточка справа от превью: надпись выезжает влево от кнопки */
    align-items: center;
    color: var(--c-accent);
    font-size: 16px;
    font-weight: 600;
  }
  .showcase--mirrored .cta {
    flex-direction: row; /* карточка слева: надпись выезжает вправо */
  }
  .cta__label {
    display: flex;
    align-items: center;
    height: 72px;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
  }
  /* Надпись выезжает: на десктопе при наведении, с клавиатуры — при фокусе.
     На планшете и мобильном (≤1100px) она видна всегда — см. медиазапрос ниже */
  a.cta:focus-visible .cta__label {
    max-width: 280px;
    margin-inline-end: 20px; /* row-reverse: надпись слева от кнопки */
    opacity: 1;
  }
  .showcase--mirrored a.cta:focus-visible .cta__label {
    margin-inline-end: 0;
    margin-inline-start: 20px;
  }
  @media (min-width: 1101px) and (hover: hover) {
    a.cta:hover .cta__label {
      max-width: 280px;
      margin-inline-end: 20px;
      opacity: 1;
    }
    .showcase--mirrored a.cta:hover .cta__label {
      margin-inline-end: 0;
      margin-inline-start: 20px;
    }
  }
  .cta__circle {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: #fff;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .cta__circle :global(svg) {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.cta:focus-visible .cta__circle {
    box-shadow: var(--shadow-btn);
  }
  a.cta:focus-visible .cta__circle :global(svg) {
    transform: rotate(-45deg); /* стрелка → превращается в ↗ */
  }
  @media (min-width: 1101px) and (hover: hover) {
    a.cta:hover .cta__circle {
      box-shadow: var(--shadow-btn);
    }
    a.cta:hover .cta__circle :global(svg) {
      transform: rotate(-45deg);
    }
  }
  .cta--static {
    cursor: default;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    margin-block-start: auto;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--c-accent);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
  }
  .meta__dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background: var(--c-accent);
  }
  .meta__tag {
    padding: 12px 24px;
    border-radius: 100px;
    background: var(--c-accent-soft);
    text-transform: uppercase;
    line-height: normal;
  }
  .info__title {
    font-size: var(--fs-card-title);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  @media (min-width: 1101px) and (hover: hover) {
    .info__title a:hover {
      color: var(--c-accent);
    }
  }
  .info__desc {
    color: var(--c-text-2);
    font-size: var(--fs-lead);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  /* Планшет/мобильный: колонка — превью сверху, карточка ниже */
  @media (max-width: 1100px) {
    .showcase,
    .showcase--mirrored {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .showcase--mirrored .showcase__media {
      order: 0;
    }
    .showcase--mirrored .showcase__card {
      order: 1;
    }
    .showcase__card,
    .showcase--mirrored .showcase__card {
      align-items: flex-start;
      flex-direction: column-reverse;
      padding-inline: 0;
      gap: 24px;
    }
    .cta__circle {
      width: 60px;
      height: 60px;
    }
    .cta__label {
      height: 60px;
    }
    .info__desc {
      margin-top: -4px; /* заголовок → описание ≈ 20px (gap 24 − 4) */
    }
  }
  @media (max-width: 767px) {
    .meta__tag {
      padding: 10px 18px;
    }

    /* Миниатюры — крупные (по пальцу), на прежнем месте поверх превью справа внизу;
       если не помещаются в ширину — лента листается свайпом */
    .thumbs {
      inset: auto 2.7% 4.3% 2.7%;
      gap: 8px;
      padding: 3px 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .thumbs li:first-child {
      margin-inline-start: auto; /* прижимает ленту вправо, но не мешает прокрутке */
    }
    .thumbs::-webkit-scrollbar {
      display: none;
    }
    .thumbs li {
      flex: 0 0 auto;
    }
    .thumb {
      width: 64px;
    }
  }

  /* Планшет и мобильный: кнопка у правого края, подпись видна всегда, стрелка уже повёрнута ↗ */
  @media (max-width: 1100px) {
    .showcase__card,
    .showcase--mirrored .showcase__card {
      align-items: stretch;
    }
    .cta,
    .showcase--mirrored .cta {
      flex-direction: row-reverse;
      align-self: flex-end;
    }
    a.cta .cta__label,
    a.cta:focus-visible .cta__label,
    .showcase--mirrored a.cta .cta__label,
    .showcase--mirrored a.cta:focus-visible .cta__label {
      max-width: none;
      margin-inline: 0 16px;
      opacity: 1;
    }
    a.cta .cta__circle :global(svg) {
      transform: rotate(-45deg);
    }
  }
</style>
