---
/** Блок cross-ссылок «Другие проекты» в конце статьи. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  href: string;
  title: string;
  tag: string;
  preview: ImageMetadata;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related container" aria-labelledby="related-title">
      <h2 class="related__title" id="related-title">
        Другие проекты
      </h2>
      <ul class="related__list">
        {items.map((item) => (
          <li>
            <a class="related__card" href={item.href}>
              <Image
                src={item.preview}
                alt=""
                width={640}
                height={360}
                widths={[320, 480, 640]}
                sizes="(max-width: 767px) 100vw, 33vw"
                loading="lazy"
              />
              <span class="related__meta">{item.tag}</span>
              <span class="related__name">{item.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: clamp(72px, 8vw, 140px);
  }
  .related__title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .related__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }
  .related__card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 8px;
    border-radius: var(--r-preview);
    transition: transform 0.3s ease;
  }
  .related__card:hover :global(img) {
    transform: translateY(-4px);
  }
  .related__meta {
    color: var(--c-accent);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
  }
  .related__name {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
    transition: color 0.2s ease;
  }
  .related__card:hover .related__name {
    color: var(--c-accent);
  }
</style>
