---
/** Блок cross-ссылок «Другие проекты» в конце статьи. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  href: string;
  title: string;
  tag: string;
  preview: ImageMetadata;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related container" aria-labelledby="related-title" data-reveal>
      <h2 class="related__title" id="related-title">
        Другие проекты
      </h2>
      <ul class="related__list">
        {items.map((item) => (
          <li>
            <a class="related__card" href={item.href}>
              <Image
                src={item.preview}
                alt=""
                width={560}
                height={315}
                widths={[280, 420, 560]}
                sizes="(max-width: 767px) 100vw, 280px"
                loading="lazy"
              />
              <span class="related__meta">{item.tag}</span>
              <span class="related__name">{item.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: clamp(72px, 8vw, 140px);
  }
  .related__title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .related__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 280px));
    gap: 24px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }
  .related__card :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 8px;
    border-radius: var(--r-preview);
    transition: transform 0.3s ease;
  }
  .related__card:hover :global(img) {
    transform: translateY(-4px);
  }
  .related__meta {
    color: var(--c-accent);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
  }
  .related__name {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
    transition: color 0.2s ease;
  }
  .related__card:hover .related__name {
    color: var(--c-accent);
  }
  /* Мобильный: горизонтальный слайдер со снапом; следующая карточка выглядывает, подсказывая свайп */
  @media (max-width: 767px) {
    .related__list {
      display: flex;
      gap: 16px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none; /* без полосы прокрутки — листается свайпом */
      -webkit-overflow-scrolling: touch;
    }
    .related__list::-webkit-scrollbar {
      display: none;
    }
    .related__list li {
      flex: 0 0 min(78%, 300px);
      scroll-snap-align: start;
    }
  }
</style>
