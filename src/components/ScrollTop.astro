---
import Icon from './Icon.astro';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a class:list={['scroll-top', className]} href="#top" aria-label="Наверх">
  <Icon name="arrow-up" />
</a>

<style>
  .scroll-top {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 24px;
    border-radius: var(--r-pill);
    background: var(--c-accent-faint);
    color: #fff;
    transition: background-color 0.2s ease;
  }
  .scroll-top:hover {
    background: rgba(138, 92, 246, 0.35);
  }
  @media (max-width: 767px) {
    .scroll-top {
      min-height: 60px;
      padding: 18px;
    }
  }
</style>
