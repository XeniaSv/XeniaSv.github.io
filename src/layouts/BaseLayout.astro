---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { url } from '../lib/url';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// картинка для репостов: абсолютный URL нужен соцсетям и мессенджерам
const ogImage = new URL(url('/og-image.jpg'), Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7defd" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={url('/favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/icon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ксения Насибуллина — UI/UX дизайнер. Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <Header />
    <slot />
    <script>
      // Базовая анимация появления: [data-reveal] и дети статьи (.prose > *) показываются, когда доходят
      // до нижней части экрана. Проверка по скроллу (а не IntersectionObserver), чтобы элементы, оставшиеся
      // выше экрана после перехода по якорю, тоже показывались.
      let pending = [
        ...document.querySelectorAll<HTMLElement>('[data-reveal]'),
        ...document.querySelectorAll<HTMLElement>('.prose > *'),
      ];
      pending.forEach((el) => el.setAttribute('data-reveal', ''));
      let queued = false;
      const check = () => {
        queued = false;
        const edge = window.innerHeight * 0.92;
        pending = pending.filter((el) => {
          if (el.getBoundingClientRect().top >= edge) return true;
          el.classList.add('is-revealed');
          return false;
        });
        if (pending.length === 0) {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
        }
      };
      const schedule = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(check);
        }
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener('load', schedule);
      check();
    </script>
  </body>
</html>
