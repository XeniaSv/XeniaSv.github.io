---
/**
 * Шаблон детальной страницы проекта: hero (крошки, H1, lead-картинка) → тело статьи + оглавление
 * → «Другие проекты» → «Вернуться на Главную».
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import BackBar from '../components/BackBar.astro';
import RelatedProjects from '../components/RelatedProjects.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  shortTitle: string;
  description: string;
  lead: ImageMetadata;
  leadCrop: { width: number; left: number; top: number };
  leadLogo?: { src: ImageMetadata; alt: string; left: number; top: number; width: number };
  toc: { slug: string; text: string }[];
  related: { href: string; title: string; tag: string; preview: ImageMetadata }[];
}
const { title, shortTitle, description, lead, leadCrop, leadLogo, toc, related } = Astro.props;
---

<BaseLayout title={`${shortTitle} — Ксения Насибуллина`} description={description}>
  <main>
    <section class="p-hero bg-hero">
      <div class="container p-hero__inner">
        <div class="p-hero__text" data-reveal>
          <nav class="crumbs" aria-label="Хлебные крошки">
            <a href={url('/')}>Главная</a>
            <span class="crumbs__sep" aria-hidden="true">/</span>
            <span aria-current="page">{shortTitle}</span>
          </nav>
          <h1 class="p-hero__title">{title}</h1>
        </div>

        <div class="lead" data-reveal style="--reveal-delay: 0.12s">
          <Image
            class="lead__img"
            src={lead}
            alt=""
            widths={[640, 960, 1400]}
            sizes="(max-width: 1100px) 100vw, 45vw"
            loading="eager"
            style={`width:${leadCrop.width}%;left:${leadCrop.left}%;top:${leadCrop.top}%`}
          />
          {
            leadLogo && (
              <Image
                class="lead__logo"
                src={leadLogo.src}
                alt={leadLogo.alt}
                width={leadLogo.src.width}
                height={leadLogo.src.height}
                loading="eager"
                style={`left:${leadLogo.left}%;top:${leadLogo.top}%;width:${leadLogo.width}%`}
              />
            )
          }
        </div>
      </div>
    </section>

    <div class="container article">
      <div class="prose">
        <slot />
      </div>
      <Toc items={toc} />
    </div>

    <RelatedProjects items={related} />

    <div class="article-end">
      <BackBar />
    </div>
  </main>
</BaseLayout>

<style>
  /* Hero */
  .p-hero {
    padding-top: clamp(120px, 12.7vw, 220px);
  }
  .p-hero__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(24px, 3vw, 48px);
  }
  .p-hero__text {
    display: flex;
    flex-direction: column;
    gap: 48px;
    flex: 0 1 878px;
    min-width: 0;
    padding-bottom: 0;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: normal;
    color: var(--c-text-2);
  }
  .crumbs a:hover {
    color: var(--c-accent);
  }
  .crumbs__sep {
    color: var(--c-accent);
    opacity: 0.5;
    font-weight: 400;
  }
  .crumbs [aria-current] {
    color: var(--c-accent);
  }
  .p-hero__title {
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    white-space: pre-line;
    text-wrap: balance;
  }

  .lead {
    position: relative;
    flex: 0 0 41%;
    aspect-ratio: 626 / 520;
    border-radius: var(--r-lead);
    overflow: hidden;
    background: #d9cbfb;
  }
  .lead :global(.lead__img) {
    position: absolute;
    height: auto;
    max-width: none;
  }
  .lead :global(.lead__logo) {
    position: absolute;
    height: auto;
    max-width: none;
  }

  /* Тело статьи + оглавление */
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(240px, 20vw, 340px);
    column-gap: clamp(32px, 3.5vw, 60px);
    align-items: start;
    padding-top: clamp(48px, 4.4vw, 76px);
  }
  .article :global(.toc) {
    grid-column: 2;
    grid-row: 1;
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    max-width: 1012px;
  }

  .article-end {
    padding-block: clamp(48px, 4.4vw, 76px) clamp(48px, 5vw, 80px);
  }

  /* Типографика статьи */
  .prose :global(> * + *) {
    margin-top: 20px;
  }
  .prose :global(h2) {
    margin-top: 48px;
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
    scroll-margin-top: 110px;
  }
  .prose :global(> h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-top: 32px;
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
    scroll-margin-top: 110px;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--c-text-2);
    font-size: var(--fs-body);
    letter-spacing: -0.04em;
  }
  .prose :global(p) {
    line-height: 1.4;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 0 24px;
    list-style: none;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 20px;
    line-height: 1.3;
  }
  .prose :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .prose :global(figure) {
    margin-top: 28px;
  }
  .prose :global(figure + h2) {
    margin-top: 56px;
  }
  .prose :global(figure + p),
  .prose :global(figure + ul),
  .prose :global(figure + h3) {
    margin-top: 28px;
  }

  @media (max-width: 1100px) {
    .p-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }
    .p-hero__text {
      flex: none;
      gap: 32px;
    }
    .lead {
      flex: none;
      width: 100%;
      max-width: 626px;
      align-self: center;
    }
    .p-hero {
      padding-bottom: 8px;
    }
    .article {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
    .article :global(.toc),
    .prose {
      grid-column: 1;
    }
    .article :global(.toc) {
      grid-row: 1;
    }
    .prose {
      grid-row: 2;
    }
  }
  @media (max-width: 767px) {
    .lead {
      border-radius: 24px;
    }
    .prose :global(h2) {
      margin-top: 40px;
    }
  }
</style>
